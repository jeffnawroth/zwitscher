<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://xamarin.com/schemas/2014/forms"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:App3" xmlns:local1="clr-namespace:App3.Services"
       x:Class="App3.AppShell"
       FlyoutBehavior="Flyout">

    <!-- Startseite Flyout Item -->
    <FlyoutItem Title="Startseite" Icon="Logo.png">
        <ShellContent Route="main" ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <!-- Posting Flyout Item -->
    <FlyoutItem Title="Posting" Icon="@Icon/posting.png">
        <ShellContent Route="posting" ContentTemplate="{DataTemplate local:PostingPage}" />
    </FlyoutItem>

    <!-- Profil Flyout Item -->
    <FlyoutItem Title="Profil" Icon="placeholder_avatar.png">
        <ShellContent Route="profile" ContentTemplate="{DataTemplate local:ProfilePage}" />
    </FlyoutItem>

    <!-- Einstellungen Flyout Item -->
    <FlyoutItem Title="Einstellungen" Icon="settings.png">
        <ShellContent Route="settings" ContentTemplate="{StaticResource SettingsTemplate}" />
    </FlyoutItem>

    <!-- Logout Flyout Item -->
    <FlyoutItem Title="Logout" Icon="logout.png">
        <ShellContent Route="logout" ContentTemplate="{DataTemplate local:Logout}" />
    </FlyoutItem>

    <!-- Resource Definitions -->
    <Shell.Resources>

        <ResourceDictionary>
            <!-- NavigationPage Style -->
            <Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="Gray" />
                <Setter Property="BarTextColor" Value="White" />
            </Style>

            <!-- MainPage DataTemplate -->
            <DataTemplate x:Key="MainPage">
                <local:MainPage />
            </DataTemplate>

            <!-- PostingPage DataTemplate -->
            <DataTemplate x:Key="PostingPage">
                <local:PostingPage />
            </DataTemplate>

            <!-- ProfilePage DataTemplate -->
            <DataTemplate x:Key="ProfilePage">
                <local:ProfilePage />
            </DataTemplate>

            <!-- SettingsPage DataTemplate -->
            <DataTemplate x:Key="SettingsTemplate">
                <local:SettingsPage />
            </DataTemplate>

            <!-- Logout DataTemplate -->
            <DataTemplate x:Key="Logout">
                <local:Logout />
            </DataTemplate>
        </ResourceDictionary>
    </Shell.Resources>
</Shell>
