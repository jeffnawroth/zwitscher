<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App3.LoginPage">

    <StackLayout Spacing="30" VerticalOptions="Center">
        <Label Text="Melde dich an..." FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Gray"/>
        <Entry x:Name="usernameEntry" Placeholder="E-Mail-Adresse/ Benutzername" PlaceholderColor="Gray" />
        <Entry x:Name="passwordEntry" Placeholder="Passwort" IsPassword="True" PlaceholderColor="Gray" />
        <Button Text="Login" Clicked="OnLoginButtonClicked" BackgroundColor="Gray" />
        <BoxView HeightRequest="20" />
        <!-- Hier wird der Platz eingefügt -->
        <StackLayout Spacing="30" Orientation="Vertical" VerticalOptions="End">
            <Label Text="Noch kein Konto?" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Gray" Margin="0,10,0,0" />
            <Button Text="Jetzt registrieren" Clicked="OnSignUpButtonClicked" BackgroundColor="Gray" />
        </StackLayout>
    </StackLayout>

</ContentPage>
