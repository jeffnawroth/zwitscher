<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App3.LoginPage">

    <StackLayout Padding="40" Spacing="30" VerticalOptions="Center">
        <Label Text="Melde dich an..." FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" />
        <Entry x:Name="usernameEntry" Placeholder="E-Mail-Adresse/ Benutzername" />
        <Entry x:Name="passwordEntry" Placeholder="Passwort" IsPassword="True" />
        <Button Text="Login" Clicked="OnLoginButtonClicked" />
        <StackLayout Padding="40" Spacing="30" Orientation="Vertical" VerticalOptions="End">
            <Label Text="Noch kein Konto?" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
            <Button Text="Jetzt anmelden" Clicked="OnSignUpButtonClicked" />
        </StackLayout>
    </StackLayout>

</ContentPage>