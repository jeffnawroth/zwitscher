        <Label Text="Bist du dir sicher, dass du dein Konto unwiderruflich löschen möchtest?" />
        <Button Text="Ja, unwiderruflich löschen" Clicked="DeleteButton_Clicked" />
    </StackLayout>
 </ContentPage>
